+// A spill copy whose DDR result nobody reads any more (its readers became
+// views of the CMX source above): drop it and its buffer.
+class RsDeadSpillCopy final : public mlir::OpRewritePattern<VPUIP::CopyOp> {
+public:
+    RsDeadSpillCopy(mlir::MLIRContext* ctx, mlir::PatternBenefit benefit)
+            : mlir::OpRewritePattern<VPUIP::CopyOp>(ctx, benefit) {
+    }
+    mlir::LogicalResult matchAndRewrite(VPUIP::CopyOp copy, mlir::PatternRewriter& rewriter) const final {
+        if (!rsDistViewEnabled() || !copy.getOutput().use_empty()) {
+            return mlir::failure();
+        }
+        if (!mlir::isa<VPUIP::DistributedBufferType>(copy.getInput().getType())) {
+            return mlir::failure();
+        }
+        auto alloc = copy.getOutputBuff().getDefiningOp<mlir::memref::AllocOp>();
+        if (alloc == nullptr || !alloc->hasOneUse()) {
+            return mlir::failure();
+        }
+        rewriter.eraseOp(copy);
+        rewriter.eraseOp(alloc);
+        return mlir::success();
+    }
+};
