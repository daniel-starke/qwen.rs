+//
+// qwen.rs (NPU_RS_DISTVIEW=1): RsDistributedViewChain
+//
+// Copy(distributed CMX -> DDR) -> pure view ops -> Copy(DDR -> distributed CMX)
+// where every cluster's segment of the source and of the destination is the
+// same contiguous byte range of the (compact) DDR tensor: the CMX buffers
+// already hold the destination's bytes, so the destination is a view of the
+// source. The upstream MovePureViewOpBeforeCopy refuses this whenever a view
+// changes the rank (4-D eltwise <-> 5-D grouped MatMul), so such edges went
+// through DDR although nothing moves.
+//
+
+static bool rsDistViewEnabled() {
+    static const bool on = [] {
+        const char* e = std::getenv("NPU_RS_DISTVIEW");
+        return e != nullptr && *e == '1';
+    }();
+    return on;
+}
+
+static bool rsSegmentsContiguous(VPUIP::DistributedBufferType t) {
+    auto dist = t.getDistribution();
+    if (dist.getMode().getValue() != VPU::DistributionMode::SEGMENTED) {
+        return false;
+    }
+    const auto shape = t.getShape();
+    const auto order = t.getDimsOrder();
+    const Bit elem = vpux::getElemTypeSize(t.getElementType());
+    const auto memShape = order.toMemoryOrder(Shape(shape.raw()));
+    const auto compact = order.toLogicalOrder(StrideReqs::compact(order.numDims()).calcStrides(elem, memShape));
+    if (t.getStrides() != compact) {
+        return false;
+    }
+    const auto shapes = t.getPerClusterMemoryShapes();
+    const auto cshapes = t.getPerClusterComputeShapes();
+    if (shapes.size() != cshapes.size()) {
+        return false;
+    }
+    const auto perm = order.toPermutation();
+    for (size_t c = 0; c < shapes.size(); ++c) {
+        if (shapes[c] != cshapes[c]) {
+            return false;
+        }
+        // memory order, outer to inner: dims of size 1, one partial dim, full dims
+        size_t i = 0;
+        while (i < perm.size() && shapes[c][perm[i]] == 1) {
+            ++i;
+        }
+        for (size_t j = i + 1; j < perm.size(); ++j) {
+            if (shapes[c][perm[j]] != shape[perm[j]]) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool rsIsCompact(mlir::Type type) {
+    auto nd = mlir::dyn_cast<vpux::NDTypeInterface>(type);
+    if (nd == nullptr) {
+        return false;
+    }
+    return StrideReqs::compact(nd.getRank()).checkStrides(nd);
+}
+
+class RsDistributedViewChain final : public mlir::OpRewritePattern<VPUIP::CopyOp> {
+public:
+    RsDistributedViewChain(mlir::MLIRContext* ctx, mlir::PatternBenefit benefit, Logger log)
+            : mlir::OpRewritePattern<VPUIP::CopyOp>(ctx, benefit), _log(log) {
+    }
+    mlir::LogicalResult matchAndRewrite(VPUIP::CopyOp dstCopy, mlir::PatternRewriter& rewriter) const final {
+        if (!rsDistViewEnabled()) {
+            return mlir::failure();
+        }
+        auto dstType = mlir::dyn_cast<VPUIP::DistributedBufferType>(dstCopy.getOutputBuff().getType());
+        if (dstType == nullptr || mlir::isa<VPUIP::DistributedBufferType>(dstCopy.getInput().getType())) {
+            return mlir::failure();
+        }
+        if (!rsIsCompact(dstCopy.getInput().getType())) {
+            return mlir::failure();
+        }
+        mlir::Value v = dstCopy.getInput();
+        VPUIP::CopyOp srcCopy = nullptr;
+        for (int depth = 0; depth < 16 && srcCopy == nullptr; ++depth) {
+            auto def = v.getDefiningOp();
+            if (def == nullptr) {
+                return mlir::failure();
+            }
+            if (auto c = mlir::dyn_cast<VPUIP::CopyOp>(def)) {
+                srcCopy = c;
+                break;
+            }
+            if (!mlir::isa<VPUIP::GenericReshapeOp, VPUIP::PermuteCastOp, VPUIP::ShapeCastOp>(def)) {
+                return mlir::failure();
+            }
+            if (!rsIsCompact(def->getOperand(0).getType()) || !rsIsCompact(def->getResult(0).getType())) {
+                return mlir::failure();
+            }
+            v = def->getOperand(0);
+        }
+        if (srcCopy == nullptr) {
+            return mlir::failure();
+        }
+        auto srcType = mlir::dyn_cast<VPUIP::DistributedBufferType>(srcCopy.getInput().getType());
+        if (srcType == nullptr || !rsIsCompact(srcCopy.getOutputBuff().getType())) {
+            return mlir::failure();
+        }
+        if (VPUIP::getRootAlloc<mlir::memref::AllocOp>(srcCopy.getOutputBuff()) == nullptr) {
+            return mlir::failure();
+        }
+        if (srcType.getElementType() != dstType.getElementType() ||
+            srcType.getDistribution().getNumClusters() != dstType.getDistribution().getNumClusters() ||
+            srcType.getShape().totalSize() != dstType.getShape().totalSize()) {
+            return mlir::failure();
+        }
+        if (!rsSegmentsContiguous(srcType) || !rsSegmentsContiguous(dstType)) {
+            return mlir::failure();
+        }
+        if (!VPUIP::areDistributedTypePerClusterDataCompatible<VPUIP::DistributedBufferType>(srcType, dstType)) {
+            return mlir::failure();
+        }
+        _log.trace("RsDistributedViewChain: {0} -> {1}", srcCopy->getLoc(), dstCopy->getLoc());
+        rewriter.replaceOpWithNewOp<VPUIP::ViewOp>(dstCopy, dstCopy.getOutput().getType(), srcCopy.getInput());
+        return mlir::success();
+    }
+
+private:
+    Logger _log;
+};
