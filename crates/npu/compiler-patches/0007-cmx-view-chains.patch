+// qwen.rs (NPU_RS_VIEWFOLD=1): a chain of pure view ops (reshape / permute
+// cast / shape cast) that ends in exactly the type it started from is an
+// identity on the buffer; drop it, so a producer's output reaches its
+// consumer without the CMX -> DDR -> CMX round trip the view chain forces.
+static bool rsIsView(mlir::Operation* op) {
+    return mlir::isa<VPU::AffineReshapeOp, VPU::PermuteCastOp, VPU::ShapeCastOp, VPU::ReshapeOp, VPU::SqueezeOp,
+                     VPU::UnsqueezeOp, VPU::LayoutCastOp>(op) &&
+           op->getNumResults() == 1;
+}
+
+static int rsFoldIdentityViews(mlir::Operation* func) {
+    int n = 0;
+    func->walk([&](mlir::Operation* op) {
+        if (!rsIsView(op)) {
+            return;
+        }
+        auto res = op->getResult(0);
+        mlir::Value v = op->getOperand(0);
+        for (int depth = 0; depth < 16; ++depth) {
+            if (v.getType() == res.getType()) {
+                res.replaceAllUsesWith(v);
+                ++n;
+                return;
+            }
+            auto def = v.getDefiningOp();
+            if (def == nullptr || !rsIsView(def)) {
+                return;
+            }
+            v = def->getOperand(0);
+        }
+    });
+    return n;
+}
+
 void MakeOpsWithDistributedTensorPass::safeRunOnFunc() {
+    if (const char* e = std::getenv("NPU_RS_VIEWFOLD"); e != nullptr && *e == '1') {
+        const auto n = rsFoldIdentityViews(getOperation());
+        if (std::getenv("NPU_RS_VIEWFOLD_LOG") != nullptr) {
+            llvm::errs() << "NPU_RS_VIEWFOLD: folded " << n << " identity view chains\n";
+        }
+    }
