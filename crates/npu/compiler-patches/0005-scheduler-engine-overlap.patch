+void FeasibleMemoryScheduler::paintFreed(size_t addr, size_t size, size_t cycle) {
+    const size_t end = addr + size;
+    if (size == 0) {
+        return;
+    }
+    // split the segments that straddle addr or end
+    auto split = [&](size_t x) {
+        auto it = _freePaint.upper_bound(x);
+        if (it == _freePaint.begin()) {
+            return;
+        }
+        --it;
+        if (it->first < x && x < it->second.first) {
+            const auto segEnd = it->second.first;
+            const auto segCycle = it->second.second;
+            it->second.first = x;
+            _freePaint.emplace(x, std::make_pair(segEnd, segCycle));
+        }
+    };
+    split(addr);
+    split(end);
+    size_t cur = addr;
+    auto it = _freePaint.lower_bound(addr);
+    while (cur < end) {
+        if (it != _freePaint.end() && it->first == cur) {
+            it->second.second = std::max(it->second.second, cycle);
+            cur = it->second.first;
+            ++it;
+        } else {
+            const size_t next = (it != _freePaint.end() && it->first < end) ? it->first : end;
+            _freePaint.emplace(cur, std::make_pair(next, cycle));
+            cur = next;
+        }
+    }
+}
+
+size_t FeasibleMemoryScheduler::freedCycle(size_t addr, size_t size) const {
+    const size_t end = addr + size;
+    size_t cycle = 0;
+    auto it = _freePaint.upper_bound(addr);
+    if (it != _freePaint.begin()) {
+        --it;
+    }
+    for (; it != _freePaint.end() && it->first < end; ++it) {
+        if (it->second.first > addr) {
+            cycle = std::max(cycle, it->second.second);
+        }
+    }
+    return cycle;
+}
