@@ -7,11 +7,51 @@
 #include "vpux/compiler/dialect/VPUIP/IR/ops.hpp"
 #include "vpux/compiler/dialect/config/IR/resources.hpp"
 #include "vpux/compiler/dialect/config/utils/config_option_utils.hpp"
+#include "vpux/compiler/dialect/config/IR/utils.hpp"
+
+#include <cstdlib>
 
 #include <mlir/Pass/AnalysisManager.h>
 
 namespace vpux {
 
+// NPU_RS_DPU1LIST=1 (qwen.rs patch): on NPU37XX the DPU invariants and the
+// ActShave invocations of all tiles share one descriptor list each (every task
+// is <0:0:i> in the ELF), so the descriptor groups must be formed over the
+// merged list in task order, not per tile. Per-tile groups let a barrier's
+// producers span three list halves (e.g. grouped MatMuls split into many
+// tasks behind an unrelated op), which hangs the runtime (device lost).
+static std::map<VPURT::TaskQueueType, SmallVector<uint32_t>> rsMergedQueues(
+        const std::map<VPURT::TaskQueueType, SmallVector<uint32_t>>& map, VPU::ExecutorKind kind,
+        mlir::func::FuncOp func) {
+    static const bool oneList = [] {
+        const char* e = std::getenv("NPU_RS_DPU1LIST");
+        return e != nullptr && e[0] == '1';
+    }();
+    auto queueMap = map;
+    if (!oneList || func == nullptr || !config::isArchVPUX3XXX(config::getArch(func))) {
+        return queueMap;
+    }
+    std::optional<VPURT::TaskQueueType> first;
+    SmallVector<uint32_t> merged;
+    for (auto it = queueMap.begin(); it != queueMap.end();) {
+        if (it->first.type != kind) {
+            ++it;
+            continue;
+        }
+        if (!first.has_value()) {
+            first = it->first;
+        }
+        merged.append(it->second.begin(), it->second.end());
+        it = queueMap.erase(it);
+    }
+    if (first.has_value()) {
+        llvm::sort(merged);
+        queueMap[*first] = merged;
+    }
+    return queueMap;
+}
