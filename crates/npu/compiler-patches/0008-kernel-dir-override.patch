 llvm::ArrayRef<uint8_t> ShaveBinaryResources::getElf(llvm::StringRef kernelPath) const {
+    // qwen.rs (NPU_RS_KERNEL_DIR=DIR): DIR/<kernelPath>.elf (e.g. inverse_3720xx.elf,
+    // inverse_3720xx_lsu0_wo.elf) replaces the embedded kernel of that name
+    if (const char* dir = std::getenv("NPU_RS_KERNEL_DIR"); dir != nullptr && *dir != 0) {
+        static std::unordered_map<std::string, std::vector<uint8_t>> overrides;
+        const auto key = kernelPath.str();
+        auto it = overrides.find(key);
+        if (it == overrides.end()) {
+            std::vector<uint8_t> data;
+            std::ifstream f(std::string(dir) + "/" + key + ".elf", std::ios::binary);
+            if (f.is_open()) {
+                data.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+            }
+            it = overrides.emplace(key, std::move(data)).first;
+        }
+        if (!it->second.empty()) {
+            return llvm::ArrayRef<uint8_t>(it->second.data(), it->second.size());
+        }
+    }
     auto symbolName = printToString("{0}_elf", kernelPath);
     const auto it = shaveBinaryResourcesMap.find(symbolName);
 
