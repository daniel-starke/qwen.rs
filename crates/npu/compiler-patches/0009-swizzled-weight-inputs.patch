+// qwen.rs: `NPU_RS_SWZIN=1` swizzles NCE weights that are copied into CMX
+// from a DDR graph input (quantized, compact copies only) instead of a
+// constant. The host must supply the input's bytes already swizzled, with
+// the period starting at the input's first byte (each copied tile must then
+// start at a multiple of the period: checked in ResolveDMAWithSwizzling); the
+// compiler only marks the CMX buffer and leaves the data alone.
+// `NPU_RS_SWZKEY=K` (1..5): the swizzle key of weights (default 5, the
+// compiler's own); a smaller key repeats every 512 << K bytes, so tiles that
+// start at such offsets can share one pre-swizzled input.
+int64_t rsWeightKey() {
+    static const int64_t key = [] {
+        const char* e = std::getenv("NPU_RS_SWZKEY");
+        const int64_t k = e != nullptr ? std::atoi(e) : 5;
+        return k >= 1 && k <= 5 ? k : int64_t(5);
+    }();
+    return key;
+}
+
+bool rsSwizzleInputs() {
+    static const bool on = [] {
+        const char* e = std::getenv("NPU_RS_SWZIN");
+        return e != nullptr && e[0] == '1';
+    }();
+    return on;
+}
+
+// A graph input: `v` reached through view ops from an argument of a public
+// (entry) function -- never a computed tensor. An argument of a private
+// (outlined) function counts when every call site passes a graph input.
+bool rsIsGraphInput(mlir::Value v, int depth = 0) {
+    while (auto* op = v.getDefiningOp()) {
+        auto view = mlir::dyn_cast<mlir::ViewLikeOpInterface>(op);
+        if (view == nullptr) {
+            return false;
+        }
+        v = view.getViewSource();
+    }
+    auto arg = mlir::dyn_cast<mlir::BlockArgument>(v);
+    if (arg == nullptr) {
+        return false;
+    }
+    auto func = mlir::dyn_cast_or_null<mlir::func::FuncOp>(arg.getOwner()->getParentOp());
+    if (func == nullptr) {
+        return false;
+    }
+    if (!func.isPrivate()) {
+        return true;
+    }
+    auto module = func->getParentOfType<mlir::ModuleOp>();
+    auto uses = mlir::SymbolTable::getSymbolUses(func, module);
+    if (depth > 4 || module == nullptr || !uses.has_value() || uses->empty()) {
+        return false;
+    }
+    for (const auto& use : *uses) {
+        auto call = mlir::dyn_cast<mlir::func::CallOp>(use.getUser());
+        if (call == nullptr || arg.getArgNumber() >= call.getNumOperands() ||
+            !rsIsGraphInput(call.getOperand(arg.getArgNumber()), depth + 1)) {
+            return false;
+        }
+    }
+    return true;
+}
